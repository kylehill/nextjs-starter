{
  "name": "nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "test:visual": "sh scripts/visual-docker.sh",
    "test:visual:update": "sh scripts/visual-docker.sh --update-snapshots",
    "test:visual:ci": "npm run build-storybook && playwright test --config playwright.visual.config.ts --pass-with-no-tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.3",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "storybook": "^10.6.3",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true
  }
}
